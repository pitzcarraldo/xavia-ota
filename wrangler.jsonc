{
  "name": "xavia-ota-updates",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/",
    "binding": "ASSETS"
  },
  // Uncomment and configure the bindings you need
